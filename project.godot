; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hero"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://Scenes/Divers/game_data.gd"
BetterTerrain="*res://addons/better-terrain/BetterTerrain.gd"
TimeManager="*res://Scenes/Divers/TimeManager/time_manager.gd"
TilePositions="*res://Ressources/tile_positions.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/better-terrain/plugin.cfg", "res://addons/modular_sprite_animation_factory/plugin.cfg")

[filesystem]

import/blender/enabled=false

