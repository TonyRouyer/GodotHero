MaterialLibrary="*res://Autoloads/Registry/MaterialLibrary.gd"
HeroGenerator="*res://Autoloads/Generator/HeroGenerator.gd"
RecruitManager="*res://Autoloads/Manager/RecruitManager.gd"
MissionManager="*res://Autoloads/Manager/MissionManager.gd"
GuildInventoryManager="*res://Autoloads/Manager/GuildInventoryManager.gd"
ResearchManager="*res://Autoloads/Manager/ResearchManager.gd"
CraftManager="*res://Autoloads/Manager/CraftManager.gd"
EnchantmentLibrary="*res://Autoloads/Registry/EnchantmentLibrary.gd"
DishLibrary="*res://Autoloads/Registry/DishLibrary.gd"
CropLibrary="*res://Autoloads/Registry/CropLibrary.gd"
FarmingManager="*res://Autoloads/Manager/FarmingManager.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/better-terrain/plugin.cfg")

[filesystem]

import/blender/enabled=false

