HeroManager="*res://Autoloads/Manager/HeroManager.gd"
ItemRegistry="*res://Autoloads/Registry/ItemRegistery.gd"
EquipmentLibrary="*res://Autoloads/Registry/EquipmentLibrary.gd"
BetterTerrain="*res://addons/better-terrain/BetterTerrain.gd"
ConstructionManager="*res://Autoloads/Manager/ConstructionManager.gd"
RoomManager="*res://Autoloads/Manager/RoomManager.gd"
HeroClassRegistry="*res://Autoloads/Registry/HeroClassRegistry.gd"
SkillLibrary="*res://Autoloads/Registry/SkillLibrary.gd"
